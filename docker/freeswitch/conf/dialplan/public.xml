<!--
  Purpose: Inbound dialplan for the 'public' context.
  Matches any incoming calls, answers them, plays a brief ringback tone,
  and parks the channel to await routing instructions from our routing service via ESL.
-->
<include>
  <context name="public">
    <extension name="inbound_pstn">
      <condition field="destination_number" expression="^(.*)$">
        <action application="answer"/>
        <action application="playback" data="tone_stream://%(1000,0,800)"/>
        <action application="park"/>
      </condition>
    </extension>
  </context>
</include>
