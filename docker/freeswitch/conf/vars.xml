<!--
  Purpose: Global variables configuration.
  Defines preprocessor variables (like domain, external IP, codecs)
  that can be referenced elsewhere in FreeSWITCH config using '$${var_name}'.
-->
<include>
  <!-- Minimal vars placeholder -->

  <!-- 
    =============================================================================
    WebRTC / NAT Traversal Configuration
    =============================================================================
    When running FreeSWITCH in Docker, OS environment variables are stripped by 
    the entrypoint. We define `external_rtp_ip` here so sofia.conf.xml can use it.
    
    For local development, hardcode this to your Mac's LAN IP (e.g. 192.168.1.x)
    so the browser can route ICE candidates properly.
    
    In production, use a startup script (or sed) to dynamically inject the 
    container's public elastic IP here on boot.
  -->
  <X-PRE-PROCESS cmd="set" data="external_rtp_ip=192.168.1.4"/>

  <!--
    SignalWire SIP trunk registration.
    Fill these locally after creating the SignalWire SIP Credential.
    Do not commit a real password.
  -->
  <X-PRE-PROCESS cmd="set" data="signalwire_sip_username=minigenesys-freeswitch"/>
  <X-PRE-PROCESS cmd="set" data="signalwire_sip_password=password123"/>
  <X-PRE-PROCESS cmd="set" data="signalwire_sip_domain=mininextiva-8ae3316fb31e.sip.signalwire.com"/>
  <X-PRE-PROCESS cmd="set" data="signalwire_caller_id=+12015021835"/>
</include>
