<!--
  Purpose: File logger configuration (mod_logfile).
  Controls log rotation, rollover sizes, and log mappings to write
  FreeSWITCH event logs to the file path `/var/log/freeswitch/freeswitch.log`.
-->
<configuration name="logfile.conf" description="File Logging">
  <settings>
    <param name="rotate-on-hup" value="true"/>
  </settings>
  <profiles>
    <profile name="default">
      <settings>
        <param name="logfile" value="/var/log/freeswitch/freeswitch.log"/>
        <param name="rollover" value="10485760"/>
      </settings>
      <mappings>
        <map name="all" value="info,notice,warn,err,crit,alert"/>
      </mappings>
    </profile>
  </profiles>
</configuration>
