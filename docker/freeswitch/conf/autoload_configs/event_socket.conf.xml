<!--
  Purpose: Event Socket Library (ESL) interface configuration (mod_event_socket).
  Configures the IP address, TCP port, password, and ACL bindings for inbound
  connections to control FreeSWITCH externally (e.g. from our Spring Boot service).
-->
<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <!-- Binds Event Socket to all network interfaces (0.0.0.0) so other containers and host port-forwarding can connect -->
    <!-- In networking terms:
         listen-ip tells the Event Socket module (mod_event_socket) which network interface it should bind to and listen for incoming TCP connection requests.
         0.0.0.0 is a wildcard IP address that tells FreeSWITCH to listen on all available network interfaces inside the container.
         Why 0.0.0.0 is required here (instead of 127.0.0.1):
         Inside the Docker container, FreeSWITCH has two main interfaces:
         Loopback (127.0.0.1): Only accessible within the container itself.
         Docker Bridge Network Interface (e.g., 172.18.0.2): Accessible to other containers and to the host machine (via port forwarding).
         If you set listen-ip to 127.0.0.1, FreeSWITCH would only bind to loopback. This would prevent the Spring Boot freeswitch-service (running on your host Mac or another container) from connecting to ESL.
         By binding to 0.0.0.0, FreeSWITCH listens on both interfaces, allowing the host machine (via Docker port mapping on host port 8022 ➜ container port 8021) to connect successfully.
      -->
    <param name="listen-ip" value="0.0.0.0"/>
    <!-- TCP port the Event Socket listens on inside the container (mapped to 8022 on host OS) -->
    <param name="listen-port" value="8021"/>
    <!-- Password required for Event Socket authentication -->
    <param name="password" value="ClueCon"/>
    <!-- References the access control list (ACL) to restrict allowed inbound connection IPs -->
    <param name="apply-inbound-acl" value="0.0.0.0/0"/>
    <!-- Prevents FreeSWITCH engine from shutting down if Event Socket fails to bind (e.g., port in use) -->
    <param name="stop-on-bind-error" value="false"/>
  </settings>
</configuration>
