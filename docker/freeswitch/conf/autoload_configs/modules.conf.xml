<!--
  Purpose: Module loading configuration.
  Specifies which modules load when the FreeSWITCH process starts.
  Only the required modules for the MVP (SIP engine, Event Socket, loopback,
  dialplans, dialplan tools, and commands) are active to keep startup lightweight.
-->
<configuration name="modules.conf" description="Modules">
  <modules>
    <!-- mod_console: Outputs log messages directly to the console/stdout (visible via docker logs) -->
    <load module="mod_console"/>
    <!-- mod_logfile: Writes log messages to files on disk -->
    <load module="mod_logfile"/>
    <!-- mod_event_socket: Provides the Event Socket Library (ESL) interface for remote Java control -->
    <load module="mod_event_socket"/>
    <!-- mod_sofia: SIP endpoint engine; handles WebRTC WebSocket connections (WS/WSS) and SIP signaling -->
    <load module="mod_sofia"/>
    <!-- mod_conference: Merges multiple call legs together in a virtual audio conference room (for customer-agent bridging) -->
    <load module="mod_conference"/>
    <!-- mod_loopback: Loopback channel simulator for mock calls and automated testing without real SIP phones -->
    <load module="mod_loopback"/>
    <!-- mod_dialplan_xml: Parses XML-based routing configurations (like dialplan/public.xml) -->
    <load module="mod_dialplan_xml"/>
    <!-- mod_dptools: Dialplan tools; provides core functions like answer(), park(), playback(), and sleep() -->
    <load module="mod_dptools"/>
    <!-- mod_commands: Provides API commands (like originate, uuid_bridge, and uuid_kill) via CLI/ESL -->
    <load module="mod_commands"/>
    <!-- mod_sndfile: Reads and writes audio files on disk (e.g., playing WAV prompts) -->
    <load module="mod_sndfile"/>
    <!-- mod_tone_stream: Generates audio tones dynamically (used for playing the customer ringback tone) -->
    <load module="mod_tone_stream"/>
    <!-- mod_opus: High-fidelity audio codec required for WebRTC browser compatibility -->
    <load module="mod_opus"/>
  </modules>
</configuration>
