<!--
  Purpose: Sofia SIP engine configuration.
  Configures the SIP profiles (external for trunk gateways, internal for WebRTC/WS/WSS clients).
  Defines SIP binding ports, registration requirements, codecs, and TLS settings.
  High-level purpose

SDP answers questions like:
- Which IP address should I send audio to?
- Which port should I use?
- Which codecs do you support?
- Audio or video?
- RTP or SRTP?

So SDP is basically:

A standardized format for describing a media session.
-->
<configuration name="sofia.conf" description="sofia Endpoint">
  <global_settings>
    <param name="log-level" value="0"/>
  </global_settings>
  <profiles>
    <profile name="external"> <!-- Used for incoming calls from SIP carriers/trunks and for registering SIP trunks (outbound). -->
      <settings>
        <param name="debug" value="0"/>
        <param name="sip-ip" value="0.0.0.0"/>  <!-- 0.0.0.0 tells FreeSWITCH to listen for SIP signaling (INVITE, ACK, etc.) on all interfaces.  -->
        <!-- Note on ext-sip-ip and ext-rtp-ip:
             While modern carriers like Telnyx use Symmetric RTP (Media Latching) to bypass broken SDP IPs, 
             configuring STUN here is still mandatory best-practice to prevent one-way audio if FreeSWITCH 
             answers a call silently without playing media first. -->
        <param name="ext-sip-ip" value="stun:stun.l.google.com:19302"/>  <!-- tells FreeSWITCH to automatically detect its external IP address via STUN -->
        <param name="rtp-ip" value="0.0.0.0"/> <!-- 0.0.0.0 tells FreeSWITCH to listen for media (RTP) traffic on all available network interfaces inside the container. -->
        <param name="ext-rtp-ip" value="stun:stun.l.google.com:19302"/> <!-- tells FreeSWITCH to automatically detect its external IP address for media traffic via STUN -->
        <param name="sip-port" value="5060"/> <!-- Standard SIP port for incoming/outgoing calls over the PSTN/SIP trunks. -->
        <param name="dialplan" value="XML"/> <!-- Tells FreeSWITCH to load dialplans from XML files in the dialplan directory. -->
        <param name="context" value="public"/> <!--When a SIP call enters this profile, send the call into dialplan context named public . -->
      </settings>
      <gateways>
        <!-- Placeholder for future carrier integration (e.g. Sinch/Bandwidth/Telnyx) -->
        
        <gateway name="telnyx">
          <param name="username" value="usermailakashkrsingh64252"/>
          <param name="password" value="wI2=rCcUVMvk"/>
          <param name="proxy" value="sip.telnyx.com"/>
          <param name="register" value="true"/>
          <param name="register-transport" value="tcp"/>
          <param name="ping" value="25"/> <!-- Keep NAT port mapping open -->
        </gateway>
       
      </gateways>
    </profile>

    <profile name="internal"> <!-- Used for internal traffic, such as WebRTC clients and applications inside the same network. -->
      <settings>
        <param name="debug" value="0"/>
        <param name="sip-ip" value="0.0.0.0"/> <!-- Listen on all interfaces for SIP signaling -->
        
        <!-- WebRTC Signaling (WebSockets): ext-sip-ip is mostly cosmetic here because all SIP 
             signaling is pushed through the persistent bidirectional WebSocket tunnel anyway. -->
        <param name="ext-sip-ip" value="$${external_rtp_ip}"/>  <!-- External IP for SIP, e.g. 192.168.1.4 -->
        
        <param name="local-network-acl" value="localnet.auto"/> <!-- Allow local LAN candidates for direct ICE connection -->
        <param name="apply-candidate-acl" value="lan"/> <!-- explicitly allow browser private IP in ICE -->
        <param name="rtcp_mux" value="true"/> <!-- Underscore compatibility fallback -->
        <param name="rtp-ip" value="0.0.0.0"/> <!-- Listen for RTP on all interfaces inside container -->
        
        <!-- WebRTC Media (ICE): ext-rtp-ip is strictly MANDATORY. The browser's ICE engine requires a 
             perfectly reachable candidate IP here to stream UDP audio, otherwise the call drops instantly. -->
        <param name="ext-rtp-ip" value="$${external_rtp_ip}"/> <!-- External IP for RTP, e.g. 192.168.1.4 -->
        
        <param name="ndlb-force-ctx-ip" value="true"/> <!-- Force ext-rtp-ip even if SIP connection appears local (Docker gateway) -->
        <param name="codec-prefs" value="opus,PCMU,PCMA,G722"/> <!-- WebRTC-compatible codecs only; SPEEX removed (Chrome rejects it) -->
        <param name="inbound-codec-prefs" value="opus,PCMU,PCMA,G722"/> <!-- Same for inbound leg -->
        <param name="outbound-codec-prefs" value="opus,PCMU,PCMA,G722"/> <!-- Same for outbound leg -->
        <param name="sip-port" value="5064"/> <!-- Standard SIP port for internal calls over the WebRTC and applications -->
        <param name="dialplan" value="XML"/> <!-- Tells FreeSWITCH to load dialplans from XML files in the dialplan directory. -->
        <param name="context" value="public"/> <!-- Default context for internal calls. -->
        <alias name="localhost"/>
        
        <!-- WebRTC WebSockets bindings -->
        <param name="ws-binding" value=":5066"/> <!-- WebSocket binding for WebRTC clients -->
        <param name="wss-binding" value=":7443"/> <!-- Encrypted WebSocket binding for WebRTC clients -->     
        
        <!-- Easy local development settings (blind registration, no auth checks) -->
        <param name="accept-blind-reg" value="true"/> <!-- Allows devices to register without passwords (not recommended for production) -->
        <param name="auth-calls" value="false"/> <!-- Disables call authentication (not recommended for production) -->
        
        <!-- RTP & Timers -->
        <param name="enable-rtp-timer" value="true"/>
        <param name="rtp-timer-name" value="soft"/>
        <param name="rtp-timeout-sec" value="300"/> 
        <param name="rtp-hold-timeout-sec" value="1800"/>
        <param name="all-reg-in-db" value="true"/>
        
        <!-- WebRTC secure TLS configuration -->
        <param name="tls" value="true"/>
        <param name="tls-only" value="false"/>
        <param name="tls-bind-params" value="transport=tls"/>
        <param name="tls-sip-port" value="5061"/>
        <param name="tls-cert-dir" value="/usr/local/freeswitch/etc/freeswitch/tls"/>
        <param name="rtp-secure-media" value="optional"/>
      </settings>
    </profile>
  </profiles>
</configuration>
