<!--
  Purpose: Conference module configuration.
  Defines the default profile for multi-party or bridged calls.
  Configures an 8kHz rate, energy levels, DTMF distribution, and a hangup grace time.
-->
<configuration name="conference.conf" description="Audio Conference">
  <advertise>
    <room name="default" status="active"/>
  </advertise>
  <profiles>
    <profile name="default">
      <!-- Sets audio mixing rate to standard PSTN telephone quality (8kHz) -->
      <param name="rate" value="8000"/>
      
      <!-- Noise Gate / VAD: Mutes participants if their mic volume drops below 300 to prevent static hiss -->
      <param name="energy-level" value="300"/>
      
      <!-- Distribute DTMF: Forwards keypad beep tones (e.g., pressing 1) through to the agent -->
      <param name="confflags" value="dist-dtmf"/>
      
      <!-- Cleanup Safety Net: Gives remaining participants 5 seconds before destroying the room when it ends -->
      <param name="endconf-grace-time" value="5"/>
    </profile>
  </profiles>
</configuration>

